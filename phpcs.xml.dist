<?xml version="1.0"?>
<ruleset>
    <rule ref="Syde-Extra" />

    <config name="testVersion" value="8.3-" />

    <file>./src</file>
    <file>./tests</file>

    <arg name="colors" />
    <arg value="sp" />

    <config name="ignore_warnings_on_exit" value="1" />

    <!-- PSR-4 namespace configuration. -->
    <rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
        <properties>
            <property name="rootNamespaces" type="array">
                <element key="src" value="n5s\BlockConverter" />
                <element key="tests" value="n5s\BlockConverter\Tests" />
                <element key="tests/unit" value="n5s\BlockConverter\Tests\Unit" />
                <element key="tests/integration" value="n5s\BlockConverter\Tests\Integration" />
            </property>
        </properties>
    </rule>

    <rule ref="Syde-Extra">
        <exclude name="Syde.Functions.FunctionLength.TooLong" />
        <exclude name="Syde.Files.LineLength.TooLong" />
        <exclude name="Syde.Classes.DisallowGetterSetter.GetterFound" />
        <!-- RegistryAwareInterface follows PSR-3's LoggerAwareInterface: the setter is the contract. -->
        <exclude name="Syde.Classes.DisallowGetterSetter.SetterFound" />
        <exclude name="Syde.NamingConventions.ElementNameMinimalLength.TooShort" />
        <exclude name="SlevomatCodingStandard.Classes.ForbiddenPublicProperty.ForbiddenPublicProperty" />
    </rule>

    <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses"/>
    <rule ref="SlevomatCodingStandard.Namespaces.UseDoesNotStartWithBackslash"/>
    <rule ref="SlevomatCodingStandard.Namespaces.FullyQualifiedGlobalConstants"/>
    <rule ref="SlevomatCodingStandard.Namespaces.FullyQualifiedGlobalFunctions">
        <properties>
            <property name="includeSpecialFunctions" value="true"/>
        </properties>
    </rule>

    <!--
        These variables mirror the WordPress HTML API they wrap
        (get_token_type(), get_modifiable_text(), create_fragment(), …) and the
        $shortcode_tags global. Renaming them to camelCase would only hide what
        they map onto, so the sniff is turned off where that is the case rather
        than everywhere.
    -->
    <rule ref="Syde.NamingConventions.VariableName.SnakeCaseVar">
        <exclude-pattern>tests/Support/*</exclude-pattern>
        <exclude-pattern>src/PreProcessors/ShortcodeProcessor\.php</exclude-pattern>
    </rule>

    <!--
        This is a library, not a plugin rendering a page: an exception message
        never reaches a browser. Escaping one adds a WordPress dependency to a
        pure-logic path and mangles the very identifier the message is meant to
        name.
    -->
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
        <severity>0</severity>
    </rule>

    <!--
        Cognitive complexity is measured, not enforced. The conversion pipeline
        genuinely branches a lot, and splitting a method to please a counter
        would spread one readable decision over several hops.
    -->
    <rule ref="SlevomatCodingStandard.Complexity.Cognitive">
        <severity>0</severity>
    </rule>

</ruleset>

{
    "name": "n5s/block-converter",
    "description": "A library to convert legacy or arbitrary HTML content into WordPress blocks.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "wordpress",
        "gutenberg",
        "blocks",
        "block-editor",
        "html",
        "converter",
        "migration",
        "shortcodes",
        "legacy-content"
    ],
    "authors": [
        {
            "name": "Nicolas Lemoine",
            "email": "nico@n5s.dev",
            "homepage": "https://n5s.dev/"
        }
    ],
    "homepage": "https://github.com/nlemoine/block-converter",
    "support": {
        "issues": "https://github.com/nlemoine/block-converter/issues",
        "source": "https://github.com/nlemoine/block-converter"
    },
    "require": {
        "php": ">=8.3",
        "psr/log": "^1 || ^2 || ^3",
        "symfony/html-sanitizer": "^7.4 || ^8",
        "symfony/polyfill-php84": "^1.33",
        "symfony/polyfill-php85": "^1.33",
        "voku/simple_html_dom": "^4.8.9 || ^5.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.48",
        "infection/infection": "^0.35",
        "mantle-framework/testkit": "^1.20",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2",
        "slevomat/coding-standard": "^8.22",
        "syde/phpcs": "^1.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "voku/portable-utf8": "^6"
    },
    "suggest": {
        "voku/portable-utf8": "Enables Utf8Fixer, which repairs mojibake and invalid byte sequences in legacy content."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "n5s\\BlockConverter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "n5s\\BlockConverter\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "alleyinteractive/composer-wordpress-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpro/grumphp-shim": true,
            "phpstan/extension-installer": true
        },
        "process-timeout": 1800
    },
    "scripts": {
        "coverage": "@php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/phpunit --coverage-text --coverage-html tmp/coverage/html",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "infection": "@php -d memory_limit=-1 vendor/bin/infection --threads=max --with-uncovered",
        "infection:diff": "@php -d memory_limit=-1 vendor/bin/infection --threads=max --with-uncovered --git-diff-base=origin/main --git-diff-lines --logger-github",
        "phpstan": "@php -d memory_limit=-1 vendor/bin/phpstan analyse",
        "qa": [
            "@cs",
            "@phpstan",
            "@rector",
            "@test"
        ],
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "coverage": "Report line coverage (text summary plus an HTML report in tmp/coverage/html).",
        "cs": "Check coding standards with PHP_CodeSniffer.",
        "cs:fix": "Auto-fix coding standard violations.",
        "infection": "Run mutation testing on the whole codebase.",
        "infection:diff": "Run mutation testing on lines changed against origin/main.",
        "phpstan": "Run static analysis.",
        "qa": "Run the full QA suite (cs, phpstan, rector dry-run, tests).",
        "rector": "Preview Rector changes without writing them.",
        "rector:fix": "Apply Rector changes.",
        "test": "Run the PHPUnit test suites."
    }
}
